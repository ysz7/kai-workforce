# Provider access and paths. Nothing else belongs here.

# API key for the LLM provider (Phase 2).
KAI_LLM_API_KEY=

# Provider endpoint. Which models exist and what they cost lives in the model
# catalog, not here - see infrastructure/llm/models.toml.
KAI_LLM_BASE_URL=https://openrouter.ai/api/v1
KAI_LLM_DEFAULT_MODEL=anthropic/claude-sonnet-5

# Point at your own catalog to override the bundled one. The bundled local
# catalog runs everything against a model on this machine, with no key and no
# cost - useful for development and for validating a phase.
# KAI_MODEL_CATALOG_PATH=infrastructure/llm/models.local.toml

# Where a locally served model listens (Ollama's default shown).
KAI_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1

# How long to wait on a provider, and how many times to retry a transient error.
KAI_LLM_TIMEOUT_SECONDS=120
KAI_LLM_RETRY_ATTEMPTS=3

# Where the SQLite file and any local artifacts live.
KAI_DATA_DIR=~/.kai-workforce

# Logging.
KAI_LOG_LEVEL=INFO
KAI_LOG_FORMAT=json

# Language the agents answer in. Never hard-code a language in the sources.
KAI_RESPONSE_LANGUAGE=en
